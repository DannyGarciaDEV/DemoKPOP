    <script>
 var today = new Date();

// Format the date as "DD Month YYYY"
var formattedDate = today.getDate() + ' ' + getMonthName(today.getMonth()) + ' ' + today.getFullYear();

// Set the formatted date as the placeholder value
document.getElementById("datepicker").setAttribute("placeholder", formattedDate);
function getMonthName(month) {
  var monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  return monthNames[month];
}
    </script>


 <script>
  let currentDate = new Date();

  // 1. Load server events
  let serverEvents = <%- JSON.stringify(events) %>;

  // 2. Convert server events into calendar event format
  let events = {};

  serverEvents.forEach(evt => {
    const date = new Date(evt.start.dateTime);
    const key = `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()}`;
   const label = `
  <a href="/event/${evt._id}" class="event-link">
    ${evt.summary}
    <span class="tooltip">
      <strong>${new Date(evt.start.dateTime).toLocaleDateString()}</strong><br>
      ${new Date(evt.start.dateTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} - ${new Date(evt.end.dateTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}<br>
      Location: ${evt.location}
    </span>
  </a>
`;
    
    if (!events[key]) events[key] = [];
    events[key].push(label);
  });

  // 3. Render calendar as before
  function saveEvents() {
    localStorage.setItem('calendarEvents', JSON.stringify(events));
  }

  function renderCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    document.getElementById("month-year").innerText = `${currentDate.toLocaleString('default', { month: 'long' })} ${year}`;

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    let calendar = '<tr>';
    const weekDays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    for (let d of weekDays) {
      calendar += `<th>${d}</th>`;
    }
    calendar += '</tr><tr>';

    for (let i = 0; i < firstDay; i++) {
      calendar += '<td></td>';
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const key = `${year}-${month + 1}-${day}`;
      const dayEvents = events[key] || [];

      calendar += `<td onclick="addEvent('${key}')"><div><strong>${day}</strong></div>`;
      dayEvents.forEach(e => {
        calendar += `<div class="event">${e}</div>`;
      });
      calendar += '</td>';

      if ((firstDay + day) % 7 === 0) {
        calendar += '</tr><tr>';
      }
    }
    calendar += '</tr>';
    document.getElementById("calendar").innerHTML = calendar;
  }

  function changeMonth(offset) {
    currentDate.setMonth(currentDate.getMonth() + offset);
    renderCalendar();
  }

  function addEvent(dateKey) {
    const eventText = prompt("Enter event:");
    if (!eventText) return;
    if (!events[dateKey]) events[dateKey] = [];
    events[dateKey].push(eventText);
    saveEvents();
    renderCalendar();
  }

  renderCalendar();
</script>
