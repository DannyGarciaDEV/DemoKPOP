    <h2 id="month-year"></h2>
    <button onclick="changeMonth(-1)">◀</button>
    <button onclick="changeMonth(1)">▶</button>
    <table id="calendar"></table>

    <div id="map" style="height: 400px;"></div>

    <div class="eventLayout">
      <% for (let j = events.length - 1; j >= 0; j--) { 
        const evt = events[j];
      %>
        <hr>
        <h3><a class="title" href="/event/<%= evt._id %>"><%= evt.summary %></a></h3>
        <div class="eventDetails">
          <span>
            <i class="far fa-clock"></i>
            <%= new Date(evt.start.dateTime).toLocaleTimeString('en-US') %> - <%= new Date(evt.end.dateTime).toLocaleTimeString('en-US') %>
          </span><br>
          <span>Date:</span> <%= new Date(evt.start.dateTime).toLocaleDateString('en-US') %> <br>
          <span>
            <i class="fas fa-map-marker-alt"></i>
            <%= evt.location %>
          </span>
        </div>
        <% if (new Date(evt.end.dateTime) < new Date()) { %>
          <p style="color:red">This event has already passed.</p>
        <% } %>
      <% } %>
    </div>

