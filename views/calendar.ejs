 <style>
  .event-link {
    position: relative;
    display: inline-block;
    cursor: pointer;
    text-decoration: none;
    color: #0056b3;
  }

  .event-link .tooltip {
    visibility: hidden;
    width: 220px;
    background-color: #333;
    color: #fff;
    text-align: left;
    padding: 8px;
    border-radius: 6px;
    position: absolute;
    z-index: 1000;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.3s;
    font-size: 12px;
  }

  .event-link:hover .tooltip {
    visibility: visible;
    opacity: 1;
  }
</style>
