        <!-- Event Form -->
        <div class="form-events">
            <form id="eventForm">
                <h2>Create a New Event</h2>
                <div class="form-group">
                    <label for="eventName">Event Summary:</label>
                    <input type="text" id="eventName" name="summary" required>
                </div>
                <div class="form-group">
                    <label for="startDate">Start Date:</label>
                    <input type="datetime-local" id="startDate" name="startDate" required>
                </div>
                <div class="form-group">
                    <label for="endDate">End Date:</label>
                    <input type="datetime-local" id="endDate" name="endDate" required>
                </div>
                <div class="form-group">
                    <label for="imageUpload">Event Image:</label>
                    <button type="button" class="btn" id="upload_widget">Upload Image</button>
                    <input type="hidden" id="uploadedImageUrl" name="imageUrl">
                </div>
                <div class="form-group">
                    <label for="location">Event Location:</label>
                    <input type="text" id="location" name="location" required>
                </div>
                <button class="btn submsg" type="submit">Submit</button>
            </form>
        </div>

        <!-- Scripts -->
        <script>
            const cloudinaryWidget = cloudinary.createUploadWidget({
                cloudName: 'df0whbpf6',

                uploadPreset: 'kpopboston',
                sources: ['local', 'url', 'camera'],
                multiple: false,
                cropping: true,
                maxFileSize: 10000000,
                theme: 'minimal'
            }, (error, result) => {
                if (!error && result && result.event === "success") {
                    console.log('Image uploaded:', result.info.secure_url);
                    document.getElementById('uploadedImageUrl').value = result.info.secure_url;
                } else {
                    console.error('Upload Error:', error);
                }
            });

            document.getElementById("upload_widget").addEventListener("click", function () {
                cloudinaryWidget.open();
            }, false);
        </script>

        <script>
            document.getElementById('eventForm').addEventListener('submit', async function (e) {
                e.preventDefault();
            
                const data = {
                    summary: document.getElementById('eventName').value,
                    startDate: document.getElementById('startDate').value,
                    endDate: document.getElementById('endDate').value,
                    location: document.getElementById('location').value,
                    imageUrl: document.getElementById('uploadedImageUrl').value
                };
            
                if (!data.imageUrl) {
                    alert("Please upload an image before submitting.");
                    return;
                }
            
                console.log("Sending data to server:", data);
            
                try {
                    const res = await fetch('/event', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    });
            
                    if (res.ok) {
                        window.location.href = res.url;
                    } else {
                        const error = await res.text();
                        console.error('Server error:', error);
                        alert('Something went wrong while creating the event.');
                    }
                } catch (err) {
                    console.error('Fetch failed:', err);
                }
            });
        </script>

