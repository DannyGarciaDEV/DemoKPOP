</body>
<script>
  document.querySelectorAll('.delete-btn').forEach(button => {
    button.addEventListener('click', async (e) => {
      e.preventDefault();
      const messageId = button.getAttribute('data-id');
      const eventId = button.getAttribute('data-event-id');

      if (confirm('Are you sure you want to delete this message?')) {
        try {
          const res = await fetch(`/event/${eventId}/message/${messageId}`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
            }
          });

          if (res.ok) {
            // Remove the message from the DOM
            button.closest('.message-container').remove();
          } else {
            const msg = await res.text();
            alert('Delete failed: ' + msg);
          }
        } catch (err) {
          console.error(err);
          alert('Something went wrong while deleting the message.');
        }
      }
    });
  });
</script>
<script>
  document.querySelectorAll('.delete-event-btn').forEach(button => {
    button.addEventListener('click', async (e) => {
      e.preventDefault();
      const eventId = button.getAttribute('data-id');

      if (confirm('Are you sure you want to delete this entire event?')) {
        try {
          const res = await fetch(`/event/${eventId}/`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json'
            }
          });

          if (res.ok) {
            alert('Event deleted successfully');
            window.location.href = '/events'; // Redirect after deletion
          } else {
            const msg = await res.text();
            alert('Failed to delete event: ' + msg);
          }
        } catch (err) {
          console.error(err);
          alert('Something went wrong while deleting the event.');
        }
      }
    });
  });
</script>

<script>
  // Toggle edit form
  document.querySelectorAll('.toggle-edit').forEach(btn => {
    btn.addEventListener('click', () => {
      const msgId = btn.getAttribute('data-id');
      const form = document.querySelector(`.edit-message-form[data-id="${msgId}"]`);
      form.style.display = form.style.display === 'none' ? 'block' : 'none';
    });
  });

  // Handle edit submit
  document.querySelectorAll('.edit-message-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const messageId = form.getAttribute('data-id');
      const eventId = form.getAttribute('data-event-id');
      const newText = form.querySelector('input[name="text"]').value;

      try {
        const res = await fetch(`/event/${eventId}/messages/${messageId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ text: newText })
        });

        if (res.ok) {
          alert('Message updated!');
          window.location.reload();
        } else {
          const msg = await res.text();
          alert('Error: ' + msg);
        }
      } catch (err) {
        console.error(err);
        alert('Something went wrong while updating.');
      }
    });
  });


</script>
</html>