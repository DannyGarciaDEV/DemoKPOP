  <div class="about-section section-padding-03">
    </div>
    <div style="display: flex; flex-direction: row; justify-content: center; align-items: center; gap: 20px;">

  
    
      <img src="<%= event.imageUrl %>" 
           style="width: 500px; height: 400px; object-fit: cover;" />
    
    </div>
   
    <section class="container">
        <h1 style="color: #fc097c;"> <%= event.summary %></h1>

  <p >Created by <strong><%= event.user %></strong></p>

<div class="container my-4 p-4 rounded shadow-sm" style="background-color: rgb(245, 237, 244);">

  <h4 class="mt-4">Description</h4>
  <p><%= event.description %></p>

  <div class="mt-4">
    <div class="mb-2 d-flex align-items-center">
      <i class="fas fa-map-marker-alt me-2 text-danger"></i>
      <span>
        Location: 
        <a href="https://www.google.com/maps/search/<%= encodeURIComponent(event.location) %>" target="_blank" rel="noopener noreferrer">
          <%= event.location %>
        </a>
      </span>
    </div>

    <div class="mb-2 d-flex align-items-center">
      <i class="far fa-calendar-alt me-2 text-info"></i>
      <span>Date: <%= new Date(event.start.dateTime).toLocaleDateString('en-US') %></span>
    </div>

    <div class="mb-2 d-flex align-items-center">
      <i class="far fa-clock me-2 text-success"></i>
      <span>Starts: <%= new Date(event.start.dateTime).toLocaleTimeString('en-US') %></span>
    </div>

    <div class="mb-4 d-flex align-items-center">
      <i class="far fa-clock me-2 text-danger"></i>
      <span>Ends: <%= new Date(event.end.dateTime).toLocaleTimeString('en-US') %></span>
    </div>
<div class="d-flex justify-content-between align-items-start mt-4">
  <% if (event.createdBy) { %>
    <button class="btn btn-danger delete-event-btn" data-id="<%= event._id %>" title="Delete Event">
      <i class="fas fa-trash-alt me-1"></i> Delete Event
    </button>
  <% } %>

  <section class="text-end">
    <% if (attendees?.length > 0) { %>
      <h5 id="attendee-count"><%= attendees.length %> K-poppers are attending</h5>
      <div id="attendee-list" class="mb-3">
      
      </div>
    <% } else { %>
      <p class="text-muted">No one is attending this event yet.</p>
    <% } %>

    <button class="btn btn-primary" id="attend-button">
      <%= isAttending ? "Attending (Click to Leave)" : "Not Attending (Click to Join)" %>
    </button>
  </section>
</div>
</div>
</div>
      <div class="container">
        <% if (messages && messages.length > 0) { %>
          <div class="testimonial-area">
            <% for (let n = 0; n < messages.length; n++) { %>
              <div class="message-container" 
                   style="border: 1px solid #fdfdfd; margin-bottom: 12px; padding: 12px; border-radius: 6px; background-color: #f9f9f9;">
                
                <p style="font-size: 1rem; margin: 0 0 8px 0;">
                  <%= messages[n].content %>
                </p>
      
                <div class="author-details" style="margin-bottom: 8px;">
                  <h5 class="name" style="font-size: 0.85rem; margin: 0;">
                    <%= messages[n].createdBy %>
                  </h5>
                  <span class="designation" style="font-size: 0.8rem; color: #555;">
                    <%= new Date(messages[n].createdAt).toLocaleString() %>
                  </span>
                </div>
      
                <% if (messages[n].createdBy === user) { %>
                  <!-- Delete Button -->
                  <button class=" btn delete-btn" 
                          data-id="<%= messages[n]._id %>" 
                          data-event-id="<%= messages[n].eventId %>" 
                          title="Delete"
                          style="margin-right: 6px;">
                    <i class="fas fa-trash"></i>
                  </button>
      
                  <!-- Edit Button -->
                  <button class="toggle-edit btn" 
                          data-id="<%= messages[n]._id %>" 
                          style="margin-right: 6px;">
                    ✏️ Edit
                  </button>
      
                  <!-- Hidden Edit Form -->
                  <form class="edit-message-form" 
                        data-id="<%= messages[n]._id %>" 
                        data-event-id="<%= messages[n].eventId %>" 
                        style="display: none; margin-top: 8px;">
                    <input type="text" name="text" value="<%= messages[n].content %>" required 
                           style="width: 80%; padding: 4px; margin-right: 6px;"/>
                    <button class="btn" type="submit" style="padding: 4px 8px;">Save</button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="testimonial-area section-padding-04">
            <p><strong>No messages for this event, be the first one to comment your thoughts below!</strong></p>
          </div>
        <% } %>
      </div>
      
      <!-- Message Comment Form -->
      <form class="form-container" id="new-message-form" style="margin-top: 20px;">
        <input type="text" name="message" placeholder="Let's Talk" required 
               style="border: 1px solid #000; padding: 8px; width: 70%; margin-right: 8px;" />
        <button class="btn msgBtn comment-btn" type="submit" style="padding: 8px 12px;">Comment</button>
      </form>
      

